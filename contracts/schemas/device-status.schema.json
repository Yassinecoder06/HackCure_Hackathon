{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borj.local/schemas/device-status.schema.json",
  "title": "Device status",
  "description": "Topic borj/{ward}/{bed}/device/status. Heartbeat and fault reports from devices (via gateway) and bedside nodes.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "required": ["bed", "deviceId", "deviceType", "status"],
  "properties": {
    "bed": { "$ref": "common.schema.json#/$defs/id" },
    "sourceType": { "enum": ["device", "bedside_node"] },
    "deviceId": { "$ref": "common.schema.json#/$defs/id" },
    "deviceType": {
      "enum": ["bedside_monitor", "pulse_oximeter", "bp_monitor", "thermometer", "infusion_pump", "bedside_node"]
    },
    "status": { "enum": ["ok", "offline", "error", "low_battery"] },
    "batteryPct": { "type": "integer", "minimum": 0, "maximum": 100 },
    "detail": { "description": "Short technical message, no patient data.", "type": "string", "maxLength": 200 }
  },
  "unevaluatedProperties": false
}
