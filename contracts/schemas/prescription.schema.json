{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borj.local/schemas/prescription.schema.json",
  "title": "Prescription (internal event)",
  "description": "Topic borj/{ward}/{bed}/prescription. INTERNAL: stored in the encrypted event log only and NEVER published on MQTT, because it contains drug names (whitepaper 4.4, 7.2). Created only by a doctor through the REST API; the system schedules and reminds from it and never selects drugs or doses (safety invariant 1).",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "required": ["bed", "admissionId", "prescriptionId", "drug", "dose", "route", "times", "startDate", "prescribedBy"],
  "properties": {
    "bed": { "$ref": "common.schema.json#/$defs/id" },
    "sourceType": { "const": "staff_app" },
    "admissionId": { "$ref": "common.schema.json#/$defs/id" },
    "prescriptionId": { "$ref": "common.schema.json#/$defs/id" },
    "drug": { "type": "string", "minLength": 1, "maxLength": 80 },
    "dose": { "type": "string", "minLength": 1, "maxLength": 40 },
    "route": { "enum": ["oral", "iv", "im", "sc", "inhaled", "topical", "other"] },
    "times": {
      "description": "Ward local times (HH:MM) at which a dose is due each day.",
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
    },
    "startDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "endDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "isInfusion": { "type": "boolean" },
    "prescribedBy": { "$ref": "common.schema.json#/$defs/id" }
  },
  "unevaluatedProperties": false
}
