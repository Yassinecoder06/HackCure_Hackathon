{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borj.local/schemas/ack.schema.json",
  "title": "Staff acknowledgement",
  "description": "Topic borj/{ward}/staff/{staffId}/ack. A staff action on a call or alert. This is the AUTHORITATIVE record that a human acted. The REST endpoints produce the same event.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "required": ["staffId", "target", "targetId", "action"],
  "properties": {
    "sourceType": { "const": "staff_app" },
    "staffId": { "$ref": "common.schema.json#/$defs/id" },
    "target": { "enum": ["call", "alert"] },
    "targetId": { "$ref": "common.schema.json#/$defs/id" },
    "action": { "enum": ["acknowledge", "resolve", "decline"] },
    "note": { "type": "string", "maxLength": 200 }
  },
  "unevaluatedProperties": false
}
