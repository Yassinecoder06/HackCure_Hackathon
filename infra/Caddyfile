# Hosted demo front door (replaces nginx): a real certificate from Let's Encrypt, TLS 1.3 only.
# docker compose -f docker-compose.yml -f docker-compose.hosted.yml up -d     with BORJ_DOMAIN=demo.example.org
# The domain's DNS A record must point at the VM, and ports 80 and 443 must be open (80 is for the certificate challenge).
{$BORJ_DOMAIN} {
	tls {
		protocols tls1.3
	}
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
	handle /api/* {
		reverse_proxy server:8000
	}
	handle /docs* {
		reverse_proxy server:8000
	}
	handle /openapi.json {
		reverse_proxy server:8000
	}
	handle /health {
		reverse_proxy server:8000
	}
	handle {
		reverse_proxy ward-app:80
	}
}

# The relatives' address. family-gateway itself stays on the dmz network only; this proxy is the one hop between the
# internet and it. The ward-only /ingest listener of family-proxy is never exposed.
{$BORJ_FAMILY_DOMAIN} {
	tls {
		protocols tls1.3
	}
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
	handle /ingest/* {
		respond 404
	}
	handle {
		reverse_proxy family-gateway:8100 {
			header_up X-Real-IP {remote_host}
		}
	}
}
