# Copy to .env and adjust. Never commit .env (safety invariant 7).
# All values here are local-dev placeholders.

BORJ_WARD=W1
MQTT_HOST=mosquitto
MQTT_PORT=1883

# Simulator
SIM_SCENARIO=night-shift-peak
SIM_SPEED=10

# Server
BORJ_DB_URL=sqlite:///data/borj.sqlite   # compose uses PostgreSQL (see docker-compose.yml)
BORJ_DATA_KEY=                 # base64 of 32 random bytes; generate with: python infra/gen_secrets.py
BORJ_DATA_KEY_ID=k1
BORJ_CLOCK_MODE=sim            # sim = use borj/{ward}/sim/clock as "now"; wall = real UTC
BORJ_MQTT_ENABLED=1            # 0 = run the API without a broker (local UI work)
BORJ_SEED_PATH=seed/ward-W1.yaml
# Frame integrity (invariant 13). Key ring "keyId:<base64 32 bytes>,..." written by infra/gen_secrets.py:
# sim-k1 (simulator), gw-k1 (gateway), node-B01..node-B10 (bedside nodes; each only signs for its own bed).
# Signers use their own entry; the server verifies with the whole ring.
BORJ_DEVICE_KEYS=
BORJ_INTEGRITY_MODE=verify     # off | verify (reject bad signatures) | require (also reject unsigned measurements)
BORJ_CORS_ORIGINS=               # extra browser origins, e.g. https://borj.example.org (localhost and LAN are always allowed)
BORJ_DEMO_ENDPOINTS=0          # 1 = enable POST /api/v1/demo/trigger-peak (charge nurse only, audited); the demo compose sets it

# Family publisher -> family-gateway (outbound only)
FAMILY_GATEWAY_URL=http://family-gateway:8100
FAMILY_PUBLISHER_TOKEN=change-me-local-dev-only
